# World Bank API Configuration
WORLD_BANK_API_URL=https://api.worldbank.org/v2
WORLD_BANK_API_KEY=
WORLD_BANK_DATE_RANGE=2000:2024
WORLD_BANK_PER_PAGE=1000
WORLD_BANK_SLEEP_SECONDS=0.6
WORLD_BANK_TIMEOUT=15
WORLD_BANK_MAX_RETRIES=3

# Target PostgreSQL Configuration (Bronze Layer - ELT)
TGT_DB_HOST=localhost
TGT_DB_PORT=5432
TGT_DB_NAME=olist_dwh
TGT_DB_USER=postgres
TGT_DB_PASSWORD=your_password
TGT_DB_SCHEMA=bronze

# Ingestion & Logging Configuration
ELT_LOAD_MODE=replace
SAVE_RAW_CSV=true
LOG_LEVEL=INFO
